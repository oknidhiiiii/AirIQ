# AirIQ - Environment Variables (.env.example)

# FastAPI Configuration
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8001
DEBUG=True

# Apache Cassandra Configuration
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=airbnb_intelligence

# Spark Configuration
SPARK_APP_NAME=AirbnbPriceIntelligence
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g

# Frontend URL for CORS
FRONTEND_ORIGIN=http://localhost:5173
